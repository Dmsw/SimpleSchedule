server {
    listen 80;
    listen [::]:80;

    server_name www.simpleschedule.site;

    root /var/www/simpleschedule;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \\.(?:css|js|png|jpg|jpeg|gif|svg|ico|webp)$ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }
}
