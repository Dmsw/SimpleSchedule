server {
    listen 80;
    listen [::]:80;
    server_name www.simpleschedule.site;
    root /var/www/simpleschedule;
    index index.html;
    client_max_body_size 30m;

    # Install HTTPS using Certbot before enabling public login.
    # Keep these locations inside the HTTPS server after certificate setup.
    location /api/ {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        add_header Cache-Control "no-store" always;
    }
    location = / { add_header Cache-Control "no-cache"; try_files /index.html =404; }
    location = /index.html { add_header Cache-Control "no-cache"; }
    location = /login.html { add_header Cache-Control "no-store"; }
    location /assets/ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    # Do not expose backend source, configuration, dotfiles, or database files.
    location / { return 404; }
    location ~ /\. { deny all; }
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
}
